# Copy this file to ../../.env.core-stack-docker (the repository root) and
# protect it with chmod 600. Never commit the resulting environment file.

# Required for production. Local development can start with Compose defaults.
POSTGRES_DB=corestack_db
POSTGRES_USER=corestack_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
GEOSERVER_USERNAME=admin
GEOSERVER_PASSWORD=replace-with-a-long-random-password

# Host paths. Source remains on the host; large layer data goes under ./data.
BACKEND_CODE_DIR=.
CORESTACK_DATA_DIR=./data
GEE_CONFS_DIR=./gee_confs
POSTGRES_BACKUP_DIR=./backups/postgres
GEOSERVER_BACKUP_DIR=./backups/geoserver

# Outbound HTTP proxy (campus/corporate networks). Leave commented to use the
# proxy your shell already exports, or none. Applied to the image build and to
# every backend/Celery container; Compose service names are always added to
# NO_PROXY.
# HTTP_PROXY=http://proxy.example.org:3128
# HTTPS_PROXY=http://proxy.example.org:3128
# NO_PROXY=.example.org

# Bind only to loopback when a reverse proxy is used.
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000
GEOSERVER_BIND_IP=127.0.0.1
GEOSERVER_PORT=8080
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432

# Django/runtime.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DB_CONN_MAX_AGE=60
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=7500
LAYER_GENERATION_SYNC_MODE=False
SYNC_LAYER=False
STAC_UPLOAD_TO_S3=False
GPU_AVAILABLE=False

# Long jobs (runoff_gpu, et_download, Pan-India hydrology) run one at a time on
# the separate celery-heavy worker. Start the stack with
# ./installation/docker/compose.sh --gpu to create it; that also turns on
# GPU_AVAILABLE and HEAVY_WORKER_ENABLED, so both usually stay False here.
HEAVY_WORKER_ENABLED=False
# Parallel tasks on the general-purpose nrm worker.
CELERY_NRM_CONCURRENCY=3

# Independent large-download switches. 1 means skip.
SKIP_ADMIN_BOUNDARY_DOWNLOAD=0
SKIP_BASE_LAYER_DOWNLOAD=0
SKIP_TEHSIL_WATERSHEDS=0

# Optional initialization switches.
SKIP_GEE_CONFIG=0
SKIP_GEOSERVER_INIT=0
SKIP_SEED_DATA=0

# Keep 0 during normal operation/upgrades. Set to 1 only when deliberately
# rebuilding local migration files for a fresh or schema-matched restored DB.
RESET_LOCAL_MIGRATIONS=0

# Optional S3 base-layer source credentials.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
S3_BUCKET=

# Optional GEE/GCS settings. The project defaults to project_id in the JSON.
GEE_STORAGE_PROJECT=
GEE_STORAGE_PROJECT_HELPER=
GCS_BUCKET_NAME=

# NASA Earthdata (GES DISC) login, required by the ET download API. Create an
# account at https://urs.earthdata.nasa.gov and authorize the "NASA GESDISC
# DATA ARCHIVE" application in your profile. Wrap values containing $ in
# single quotes. Apply with: ./installation/docker/compose.sh up -d --force-recreate
USERNAME_GESDISC=
PASSWORD_GESDISC=

# Optional first-start superuser. Leave all three empty to create one manually.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Enable only after reviewing django-celery-beat schedules.
# Start with: ./installation/docker/compose.sh --profile periodic up -d celery-beat
