# Copy this file to ../../nrm_app/.env and protect it with chmod 600.
# This is the single environment file read by both Docker Compose and Django.

# All persistent host files are placed below this directory as data/,
# gee_confs/, backups/postgres/ and backups/geoserver/. Use an absolute path in
# production, for example /srv/core-stack-data.
CORESTACK_HOST_DATA_DIR=.

# Application source remains in the checkout and is mounted into the backend.
BACKEND_CODE_DIR=.

# Bind service ports to loopback unless a reverse proxy requires otherwise.
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000
GEOSERVER_BIND_IP=127.0.0.1
GEOSERVER_PORT=8080
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432



SECRET_KEY=change-me-in-docker
DEBUG=True
LAYER_GENERATION_SYNC_MODE=False
SYNC_LAYER=False
STAC_UPLOAD_TO_S3=False
# Long jobs (runoff_gpu, et_download, Pan-India hydrology) run one at a time on
# the celery-heavy worker, which also holds the GPU. It is not created unless
# the "heavy" Compose profile is selected. Without it -- the default, and what
# hosts with no GPU use -- those endpoints answer 503 instead of queueing work
# that nothing would run. On a GPU machine with the NVIDIA Container Toolkit,
# uncomment the profile line; GPU_AVAILABLE and HEAVY_WORKER_ENABLED then
# follow it automatically.
# COMPOSE_PROFILES=heavy

# Uncomment either one to override what the profile implies, for example
# GPU_AVAILABLE=False with the profile on, to serialize the CPU-bound jobs on a
# host without a GPU.
# GPU_AVAILABLE=False
# HEAVY_WORKER_ENABLED=False

DB_CONN_MAX_AGE=60
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=7500

DB_NAME=corestack_db
DB_USER=corestack_admin
DB_PASSWORD=replace-with-a-long-random-password
# Admin user created on first start. Leave empty to create one later with
# createsuperuser. Quote values that contain $.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/
CELERY_TASK_ALWAYS_EAGER=False
# Tasks the general-purpose nrm worker runs in parallel.
CELERY_NRM_CONCURRENCY=3

ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0,[::1]

GEOSERVER_URL=http://geoserver:8080/geoserver/
GEOSERVER_USERNAME=admin
GEOSERVER_PASSWORD=replace-with-a-long-random-password

# Independent large-download switches. 1 means skip.
SKIP_ADMIN_BOUNDARY_DOWNLOAD=0
# Base layers need S3 credentials (S3_ACCESS_KEY/S3_SECRET_KEY); copy them into
# data/base_layers/ instead, or set 0 once the credentials are filled in.
SKIP_BASE_LAYER_DOWNLOAD=1
SKIP_TEHSIL_WATERSHEDS=0

# Optional initialization switches.
SKIP_GEE_CONFIG=0
SKIP_GEOSERVER_INIT=0
SKIP_SEED_DATA=0
RESET_LOCAL_MIGRATIONS=0

BACKEND_DIR=/app
DATA_DIR=/var/tmp/core-stack-data
EXCEL_DIR=/var/tmp/core-stack-data/excel_files
EXCEL_PATH=/app
DEPLOYMENT_DIR=/app
TMP_LOCATION=/app/tmp
WHATSAPP_MEDIA_PATH=/app/bot_interface/whatsapp_media
NREGA_BUCKET=naregageojson
PUBLIC_API_BASE_URL=https://geoserver.core-stack.org/api/v1
PUBLIC_API_X_API_KEY=
